# Copy to .release.env (gitignored) and fill in — then run scripts/build-release.sh
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# Mapas: osm (default, donado, solo uso liviano) o thunderforest.
# Con thunderforest hace falta la key: https://manage.thunderforest.com
TILE_PROVIDER=osm
THUNDERFOREST_KEY=
