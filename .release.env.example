# Copy to .release.env (gitignored) and fill in — then run scripts/build-release.sh
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# Mapas: osm (default, donado, solo uso liviano) o thunderforest.
# Con thunderforest hace falta la key: https://manage.thunderforest.com
TILE_PROVIDER=osm
THUNDERFOREST_KEY=

# Cualquier otro proveedor raster (Stadia, MapTiler, uno propio) entra por acá
# con TILE_PROVIDER=custom, sin tocar código. Poné el template exacto que
# publique el proveedor y su crédito obligatorio.
#TILE_URL_TEMPLATE=https://<host>/<estilo>/{z}/{x}/{y}.png?api_key=<key>
#TILE_ATTRIBUTION=© <Proveedor>, © OpenStreetMap contributors

# Geocodificación inversa (dirección del pin). Nominatim por defecto: servidores
# donados con techo de 1 request/segundo para TODA la app. Se puede apuntar a un
# Nominatim propio, Photon o un servicio pago sin publicar versión nueva.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
